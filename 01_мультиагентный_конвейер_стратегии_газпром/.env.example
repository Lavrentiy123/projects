# Настройки подключения к LLM (Model-Agnostic OpenAI-compatible interface)
# Для внешнего контура (PoC):
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o

# Для закрытого On-Premise контура компании (раскомментировать при переносе на внутренний сервер vLLM):
# LLM_BASE_URL=http://internal-vllm.corp.gazprom-neft.ru:8000/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=qwen2.5-72b-instruct

# Поисковый слой (duckduckgo-search полностью бесплатный, ключи не требуются)
