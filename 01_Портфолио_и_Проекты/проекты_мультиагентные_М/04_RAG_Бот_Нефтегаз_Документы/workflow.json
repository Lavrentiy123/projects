    {
      "parameters": {
        "jsCode": "try {\n  const text = $input.first().json.output || '';\n  // Telegram MarkdownV2 has strict escaping rules.\n  // Easier to strip markdown than to escape every special character.\n  const clean = text\n    .replace(/\\*\\*/g, '')\n    .replace(/\\*/g, '')\n    .replace(/_/g, ' ')\n    .replace(/`/g, '');\n  return [{ json: { cleanText: clean } }];\n} catch (error) {\n  return [{ json: { text: 'Error during markdown cleanup', error: error.message } }];\n}"
      },
