      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-240, 16],
      "id": "loop-over-items",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "jsCode": "// Telegram has a 4096-character limit per message.\n// Split long answers into multiple messages.\ntry {\n  const text = $input.first().json.cleanText;\n  const maxLen = 4000;\n  const chunks = [];\n  for (let i = 0; i < text.length; i += maxLen) {\n    chunks.push({ json: { text: text.substring(i, i + maxLen) } });\n  }\n  return chunks;\n} catch (error) {\n  return [{ json: { text: 'Error during message chunking', error: error.message } }];\n}"
      },
