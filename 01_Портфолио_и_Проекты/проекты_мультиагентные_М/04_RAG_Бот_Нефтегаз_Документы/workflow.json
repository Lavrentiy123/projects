    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst chunkCount = items.length;\nreturn [{\n  json: {\n    text: `✅ Документ обработан!\\n📄 Создано ${chunkCount} фрагментов в базе знаний.\\nТеперь можете задавать вопросы по этому документу.`,\n    chatId: $('Telegram Trigger').item.json.message.chat.id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0],
      "id": "code-completion-msg",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "// Two-level chunking workaround for n8n-cloud OOM.\n// Large PDFs (200+ pages) caused 'run out of memory' errors\n// because all chunks were held in memory simultaneously.\n// Solution: split the extracted text into 50K-character pieces,\n// then Loop Over Items processes them sequentially.\nconst text = $input.first().json.text;\nconst maxChunkSize = 50000;\n\nif (!text || text.length === 0) {\n  return [{\n    json: {\n      error: true,\n      text: '⚠️ Не удалось извлечь текст из документа.',\n      chatId: $('Telegram Trigger').item.json.message.chat.id\n    }\n  }];\n}\n\nif (text.length <= maxChunkSize) {\n  return $input.all();\n}\n\nconst chunks = [];\nfor (let i = 0; i < text.length; i += maxChunkSize) {\n  chunks.push({\n    json: {\n      data: text.substring(i, i + maxChunkSize)\n    }\n  });\n}\n\nreturn chunks;"
      },
